# Template only — no values. Copy to .env and fill in.
#
# vite.config.ts calls loadEnv(mode, cwd, "") which loads EVERY var in these
# files into process.env, not just VITE_ ones. So a secret pasted into any
# .env file is readable by server code — and, before the .gitignore rule,
# would have been committed. Keep the two halves below straight.

# ---------------------------------------------------------------------------
# CLIENT — Vite inlines these into the browser bundle at build time.
# They are PUBLIC the moment you ship. Never put a secret here.
# Currently supplied by the committed .env / .env.<mode> files.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_VAPI_ASSISTANT_ID=
VITE_VAPI_PUBLIC_KEY=
VITE_PAYMENTS_CLIENT_TOKEN=

# Supplied by .github/workflows/deploy.yml on CI builds, not by a file.
VITE_APP_ENV=
VITE_APP_RELEASE=
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# SERVER — read via process.env by *.server.ts code. Never sent to the browser.
# ---------------------------------------------------------------------------
# Non-secret, currently in the committed .env:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
APP_ENV=
APP_RELEASE=
SENTRY_DSN=

# SECRETS — these are referenced by src/ but are NOT in any committed file, and
# must stay that way. They live in Cloudflare Worker secrets and Lovable
# Project Settings. Listed here only so the required set is discoverable.
#
# Not every one is reached as `process.env.NAME`. Some go through the
# getEnv("NAME") helper in src/lib/stripe.server.ts, and the payments webhook
# picks its key by branching on a variable. Grepping for `process.env` alone
# misses those, so check getEnv() calls and bare "SCREAMING_CASE" literals too
# when adding to this list.
# SUPABASE_SERVICE_ROLE_KEY grants full database access and bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
# Stripe webhook signing secrets; the handler picks one by payment mode.
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
VAPI_SERVER_SECRET=
SLACK_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_CONSOLE_API_KEY=
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
LEADCONNECTOR_WEBHOOK_TOKEN=
GHL_INBOUND_WEBHOOK_URL=
