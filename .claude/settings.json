{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__n8n__get_node_types$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/get-node.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n__create_workflow_from_code$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/create-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n__update_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/update-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/validate-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n__execute_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/execute-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n__test_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/test-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__get_node$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/get-node.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__n8n_create_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/create-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__(n8n_update_partial_workflow|n8n_update_full_workflow)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/update-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__(validate_workflow|n8n_validate_workflow)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/validate-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__n8n_test_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/test-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__n8n_instances$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/instances.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__n8n_manage_credentials$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/pre-tool-use/manage-credentials.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__n8n__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use/validate-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__n8n-mcp__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/community/post-tool-use/validate-workflow.sh\""
          }
        ]
      }
    ]
  }
}
