{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__get_node_types$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/get-node.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__create_workflow_from_code$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/create-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__update_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/update-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/validate-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__execute_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/execute-workflow.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__.*__test_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use/test-workflow.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__validate_workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use/validate-workflow.sh\""
          }
        ]
      }
    ]
  }
}
